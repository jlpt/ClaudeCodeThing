index 0000000..9a12ead
--- /dev/null
+++ b/src/core2/bs/malevolent_shrine.inc
@@ -0,0 +1,495 @@
+/*
+ * Mod: "Domain Expansion: Malevolent Shrine" (Jujutsu Kaisen).
+ *
+ * Press L while standing or walking on the ground as Banjo. Banjo turns to the
+ * camera, makes the hand sign (ASSET_4_ANIM_BSSHRINE), the shrine
+ * (ASSET_2D8_MODEL_MALEVOLENT_SHRINE) rises up behind him, the screen turns
+ * blood red, and every enemy within range is slashed to pieces for a few
+ * seconds. The shrine fades away when the domain ends.
+ *
+ * Included at the end of bs/jig.c so it lives in the core2 overlay without
+ * changing the splat segment layout.
+ */
+
+#include "time.h"
+#include "core1/viewport.h"
+#include "core2/modelRender.h"
+
+#define SHRINE_DURATION        7.0f
+#define SHRINE_TEXT1_START     0.9f
+#define SHRINE_TEXT2_START     2.0f
+#define SHRINE_TEXT_END        4.6f
+#define SHRINE_SLASH_START     2.3f
+#define SHRINE_SLASH_END       5.7f
+#define SHRINE_FADE_END        6.5f
+#define SHRINE_RADIUS          2500.0f
+#define SHRINE_MAX_SLASHES     12
+#define SHRINE_BAR_HEIGHT      30.0f
+#define SHRINE_MODEL_APPEAR    1.8f    /* shrine starts rising behind Banjo */
+#define SHRINE_MODEL_RISE      0.7f    /* seconds to rise and fade in */
+/* Framing: after the hand sign the close-up camera pulls back from 290 to 1100 units and aims
+ * 260 above Banjo, so the whole shrine fits between the letterbox bars with Banjo in front. */
+#define SHRINE_CAMERA_ZOOM_START 1.8f
+#define SHRINE_CAMERA_ZOOM_TIME  0.9f
+#define SHRINE_CAMERA_NEAR       290.0f   /* vanilla jiggy close-up distance */
+#define SHRINE_CAMERA_FAR        1100.0f
+#define SHRINE_CAMERA_LOOK_NEAR  100.0f   /* vanilla look-at height */
+#define SHRINE_CAMERA_LOOK_FAR   260.0f
+#define SHRINE_MODEL_DISTANCE  1600.0f /* how far behind Banjo it stands */
+#define SHRINE_MODEL_DROP      350.0f  /* base below Banjo's feet */
+#define SHRINE_MODEL_SCALE     1.5f
+#define SHRINE_MODEL_DEPTH     600.0f  /* extra depth it rises up from */
+
+typedef struct {
+    f32 x0, y0, x1, y1; /* screen pixels */
+    f32 life;           /* seconds remaining */
+    f32 width;
+} ShrineSlash;
+
+/* .bss */
+static f32 sShrineTimer;
+static f32 sShrineHitTimer;
+static f32 sShrineSfxTimer;
+static f32 sShrineSlashSpawnTimer;
+static u8  sShrineActive;
+static u8  sShrineSweep;
+static s32 sShrineHitbox;
+static u8  sShrineThunderPlayed;
+static u8  sShrineNamePlayed;
+static ShrineSlash sShrineSlashes[SHRINE_MAX_SLASHES];
+static BKModelBin *sShrineModel;
+static u8  sShrinePlaced;
+static f32 sShrinePosition[3];
+static f32 sShrineYaw;
+
+/* .code */
+static f32 __bsshrine_clamp01(f32 v){
+    if(v < 0.0f) return 0.0f;
+    if(v > 1.0f) return 1.0f;
+    return v;
+}
+
+/* 0..1 strength of the domain's screen effect for the current timer value */
+/* only draw while Banjo is really in the domain state (guards against stale data) */
+static int __bsshrine_isRunning(void){
+    return sShrineActive && bs_getState() == BS_A6_MALEVOLENT_SHRINE;
+}
+
+static f32 __bsshrine_intensity(void){
+    if(!__bsshrine_isRunning())
+        return 0.0f;
+    if(sShrineTimer < SHRINE_TEXT2_START)
+        return __bsshrine_clamp01(sShrineTimer / SHRINE_TEXT2_START) * 0.6f;
+    if(sShrineTimer < SHRINE_SLASH_END)
+        return 0.6f + __bsshrine_clamp01((sShrineTimer - SHRINE_TEXT2_START) / 0.3f) * 0.4f;
+    return 1.0f - __bsshrine_clamp01((sShrineTimer - SHRINE_SLASH_END) / (SHRINE_FADE_END - SHRINE_SLASH_END));
+}
+
+static int __bsshrine_canSlash(Actor *actor){
+    return !actor->unk124_0;
+}
+
+/*
+ * Most enemies take damage through the collision table, which asks which attack
+ * Banjo is doing (see hitbox_getHitboxForActor). Each sweep of the domain
+ * pretends to be a different attack so every kind of enemy gets cut by
+ * something that hurts it.
+ */
+s32 bsshrine_getHitbox(void){
+    return sShrineHitbox;
+}
+
+static void __bsshrine_sweep(void){
+    static s32 attacks[] = {
+        HITBOX_3_BEAK_BOMB, HITBOX_1_BEAK_BUSTER, HITBOX_2_BEAK_BARGE, HITBOX_7_ROLL,
+        HITBOX_4_CLAW, HITBOX_5_PECK, HITBOX_A_FAST_FALLING
+    };
+    f32 player_position[3];
+
+    playerPosition_get(player_position);
+    sShrineHitbox = attacks[sShrineSweep % (sizeof(attacks) / sizeof(attacks[0]))];
+    sShrineSweep++;
+    func_8032728C(player_position, SHRINE_RADIUS, MARKER_COLLISION_FUNC_2_DIE, __bsshrine_canSlash);
+    sShrineHitbox = HITBOX_0_NONE;
+}
+
+static void __bsshrine_spawnSlash(void){
+    ShrineSlash *s;
+    f32 cx, cy, len, ang, dx, dy;
+    s32 i;
+
+    for(i = 0; i < SHRINE_MAX_SLASHES; i++){
+        if(sShrineSlashes[i].life <= 0.0f)
+            break;
+    }
+    if(i == SHRINE_MAX_SLASHES)
+        return;
+
+    s = &sShrineSlashes[i];
+    cx = randf2(20.0f, 300.0f);
+    cy = randf2(20.0f, 220.0f);
+    len = randf2(90.0f, 220.0f);
+    ang = randf2(0.0f, 3.14159f);
+    dx = cosf(ang) * len * 0.5f;
+    dy = sinf(ang) * len * 0.5f;
+    s->x0 = cx - dx;
+    s->y0 = cy - dy;
+    s->x1 = cx + dx;
+    s->y1 = cy + dy;
+    s->width = randf2(1.0f, 2.5f);
+    s->life = randf2(0.12f, 0.22f);
+}
+
+static void __bsshrine_reset(void){
+    s32 i;
+
+    sShrineTimer = 0.0f;
+    sShrineHitTimer = 0.0f;
+    sShrineSfxTimer = 0.0f;
+    sShrineSlashSpawnTimer = 0.0f;
+    sShrineSweep = 0;
+    sShrineHitbox = HITBOX_0_NONE;
+    sShrineThunderPlayed = FALSE;
+    sShrineNamePlayed = FALSE;
+    for(i = 0; i < SHRINE_MAX_SLASHES; i++){
+        sShrineSlashes[i].life = 0.0f;
+    }
+}
+
+bool bsshrine_canStart(void){
+    return bsStoredState_getTransformation() == TRANSFORM_1_BANJO
+        && !player_inWater()
+        && !player_isSliding();
+}
+
+/* Stand the shrine behind Banjo, on the far side from the camera, facing the camera. */
+static void __bsshrine_placeModel(void){
+    f32 player_position[3];
+    f32 camera_position[3];
+    f32 dx, dz, len;
+
+    playerPosition_get(player_position);
+    viewport_getPosition_vec3f(camera_position);
+    dx = player_position[0] - camera_position[0];
+    dz = player_position[2] - camera_position[2];
+    len = sqrtf(dx * dx + dz * dz);
+    if(len < 1.0f){
+        dx = 0.0f; dz = -1.0f; len = 1.0f;
+    }
+    dx /= len;
+    dz /= len;
+    sShrinePosition[0] = player_position[0] + dx * SHRINE_MODEL_DISTANCE;
+    sShrinePosition[1] = player_position[1] - SHRINE_MODEL_DROP;
+    sShrinePosition[2] = player_position[2] + dz * SHRINE_MODEL_DISTANCE;
+    /* face the camera, the same way Banjo is turned (both are drawn by modelRender_draw) */
+    sShrineYaw = func_8029B41C();
+    sShrinePlaced = TRUE;
+}
+
+static void __bsshrine_freeModel(void){
+    if(sShrineModel != NULL){
+        assetcache_release(sShrineModel);
+        sShrineModel = NULL;
+    }
+    sShrinePlaced = FALSE;
+}
+
+void bsshrine_init(void){
+    AnimCtrl *aCtrl = baanim_getAnimCtrlPtr();
+
+    __bsshrine_reset();
+    sShrineActive = TRUE;
+    sShrinePlaced = FALSE;
+    sShrineModel = assetcache_get(ASSET_2D8_MODEL_MALEVOLENT_SHRINE); // released in bsshrine_end
+
+    anctrl_reset(aCtrl);
+    anctrl_setSmoothTransition(aCtrl, TRUE);
+    anctrl_setIndex(aCtrl, ASSET_4_ANIM_BSSHRINE);
+    anctrl_setDuration(aCtrl, SHRINE_DURATION);
+    anctrl_setPlaybackType(aCtrl, ANIMCTRL_ONCE);
+    anctrl_start(aCtrl, "bsshrine.c", 0x1);
+
+    yaw_setIdeal(func_8029B41C()); //face camera
+    code_14420_setUpdateTypes(1, YAW_STATE_1_DEFAULT, 3, BA_PHYSICS_NORMAL);
+    baphysics_set_target_horizontal_velocity(0.0f);
+
+    /* hush the level music for the domain */
+    midichannel_incOrDecCounter(FALSE);
+    func_8025A2FC(0, 0xfa0);
+
+    func_8029151C(0xC); //close-up camera, same as the jiggy dance
+    baMarker_collisionOff();
+    func_8030E58C(SFX_146_GRUNTY_SPELL_ATTACK_1, 0.6f);
+}
+
+void bsshrine_update(void){
+    enum bs_e next_state = 0;
+    f32 dt = time_getDelta();
+    s32 i;
+
+    yaw_setIdeal(func_8029B41C());
+    sShrineTimer += dt;
+
+    for(i = 0; i < SHRINE_MAX_SLASHES; i++){
+        if(sShrineSlashes[i].life > 0.0f)
+            sShrineSlashes[i].life -= dt;
+    }
+
+    if(!sShrineThunderPlayed && sShrineTimer >= SHRINE_TEXT1_START){
+        sShrineThunderPlayed = TRUE;
+        func_8030E58C(SFX_B5_THUNDERBOLT, 0.8f);
+        baMotor_80250D94(0.8f, 0.4f, 0.3f);
+    }
+
+    if(sShrineTimer >= SHRINE_CAMERA_ZOOM_START){
+        /* pull the camera back to reveal the shrine */
+        f32 z = __bsshrine_clamp01((sShrineTimer - SHRINE_CAMERA_ZOOM_START) / SHRINE_CAMERA_ZOOM_TIME);
+        z = z * z * (3.0f - 2.0f * z);
+        func_802BFF80(SHRINE_CAMERA_NEAR + (SHRINE_CAMERA_FAR - SHRINE_CAMERA_NEAR) * z);
+        ncDynamicCamC_setLookHeight(SHRINE_CAMERA_LOOK_NEAR + (SHRINE_CAMERA_LOOK_FAR - SHRINE_CAMERA_LOOK_NEAR) * z);
+    }
+
+    if(!sShrinePlaced && sShrineTimer >= SHRINE_MODEL_APPEAR){
+        __bsshrine_placeModel();
+        func_8030E58C(SFX_1B_EXPLOSION_1, 0.5f);
+        baMotor_80250D94(0.6f, 0.5f, 0.5f);
+    }
+
+    if(!sShrineNamePlayed && sShrineTimer >= SHRINE_TEXT2_START){
+        sShrineNamePlayed = TRUE;
+        func_8030E58C(SFX_B5_THUNDERBOLT, 0.55f);
+        func_8030E58C(SFX_A6_MAGICAL_FINISH, 0.6f);
+        baMotor_80250D94(1.0f, 0.6f, 0.6f);
+    }
+
+    if(SHRINE_TEXT1_START <= sShrineTimer && sShrineTimer < SHRINE_TEXT_END){
+        print_dialog(89, 15, "DOMAIN EXPANSION");      /* in the top letterbox bar */
+    }
+    if(SHRINE_TEXT2_START <= sShrineTimer && sShrineTimer < SHRINE_TEXT_END){
+        print_bold_overlapping(36, 203, 0.8f, "MALEVOLENT SHRINE"); /* in the bottom bar */
+    }
+
+    if(SHRINE_SLASH_START <= sShrineTimer && sShrineTimer < SHRINE_SLASH_END){
+        /* Dismantle & Cleave: everything in range gets cut, repeatedly */
+        sShrineHitTimer -= dt;
+        if(sShrineHitTimer <= 0.0f){
+            sShrineHitTimer = 0.3f;
+            __bsshrine_sweep();
+        }
+
+        sShrineSfxTimer -= dt;
+        if(sShrineSfxTimer <= 0.0f){
+            sShrineSfxTimer = randf2(0.07f, 0.16f);
+            func_8030E58C((randf2(0.0f, 1.0f) < 0.5f) ? SFX_2_CLAW_SWIPE : SFX_129_SWOOSH, randf2(0.9f, 1.5f));
+        }
+
+        sShrineSlashSpawnTimer -= dt;
+        if(sShrineSlashSpawnTimer <= 0.0f){
+            sShrineSlashSpawnTimer = randf2(0.01f, 0.035f);
+            __bsshrine_spawnSlash();
+        }
+    }
+
+    if(anctrl_isStopped(baanim_getAnimCtrlPtr()) || sShrineTimer >= SHRINE_DURATION + 0.5f)
+        next_state = BS_1_IDLE;
+
+    bs_setState(next_state);
+}
+
+void bsshrine_end(void){
+    sShrineActive = FALSE;
+    __bsshrine_reset();
+    __bsshrine_freeModel();
+    func_80291548();
+    func_8025A2FC(-1, 0xfa0);
+    midichannel_incOrDecCounter(TRUE);
+    baMarker_collisionOn();
+}
+
+void bsshrine_interrupt(void){
+    func_80296590();
+}
+
+/*
+ * The shrine is drawn from baModel_draw just before Banjo, after the level's
+ * opaque geometry, with depth testing off: it paints over the scenery like a
+ * backdrop (the domain replaces the surroundings) and Banjo is drawn on top.
+ */
+void bsshrine_drawShrine(Gfx **gfx, Mtx **mtx, Vtx **vtx){
+    f32 t, rise, fade, ease;
+    f32 position[3];
+    f32 rotation[3];
+    s32 alpha;
+
+    if(!__bsshrine_isRunning() || !sShrinePlaced || sShrineModel == NULL)
+        return;
+
+    t = sShrineTimer - SHRINE_MODEL_APPEAR;
+    rise = __bsshrine_clamp01(t / SHRINE_MODEL_RISE);
+    ease = 1.0f - (1.0f - rise) * (1.0f - rise);
+    fade = 1.0f - __bsshrine_clamp01((sShrineTimer - SHRINE_SLASH_END) / (SHRINE_FADE_END - SHRINE_SLASH_END));
+    alpha = (s32)(255.0f * __bsshrine_clamp01(rise * 1.6f) * fade);
+    if(alpha <= 0)
+        return;
+
+    position[0] = sShrinePosition[0];
+    position[1] = sShrinePosition[1] - (1.0f - ease) * SHRINE_MODEL_DEPTH;
+    position[2] = sShrinePosition[2];
+    rotation[0] = 0.0f;
+    rotation[1] = sShrineYaw;
+    rotation[2] = 0.0f;
+
+    modelRender_setDepthMode(MODEL_RENDER_DEPTH_NONE);
+    modelRender_setAlpha(alpha);
+    modelRender_draw(gfx, mtx, position, rotation, SHRINE_MODEL_SCALE * (0.85f + 0.15f * ease), NULL, sShrineModel);
+}
+
+/*
+ * Screen-space overlay, drawn after the 3D world and before the HUD.
+ * Coordinates: viewport_setRenderViewportAndOrthoMatrix maps x in [-2W, 2W]
+ * and y in [-2H, 2H], so one screen pixel is 4 units with the origin centred.
+ */
+static void __bsshrine_setVtx(Vtx *v, f32 px, f32 py, u8 r, u8 g, u8 b, u8 a){
+    v->v.ob[0] = (s16)((px - gFramebufferWidth * 0.5f) * 4.0f);
+    v->v.ob[1] = (s16)((gFramebufferHeight * 0.5f - py) * 4.0f);
+    v->v.ob[2] = -5;
+    v->v.flag = 0;
+    v->v.tc[0] = 0;
+    v->v.tc[1] = 0;
+    v->v.cn[0] = r;
+    v->v.cn[1] = g;
+    v->v.cn[2] = b;
+    v->v.cn[3] = a;
+}
+
+/* Emits one quad (4 vertices, 2 triangles). Quads are batched 4 per vertex load. */
+static void __bsshrine_quad(Gfx **gfx, Vtx **vtx, f32 p[4][2], u8 r, u8 g, u8 b, u8 a){
+    Vtx *v = *vtx;
+    s32 i;
+
+    for(i = 0; i < 4; i++){
+        __bsshrine_setVtx(&v[i], p[i][0], p[i][1], r, g, b, a);
+    }
+    gSPVertex((*gfx)++, osVirtualToPhysical(v), 4, 0);
+    gSP2Triangles((*gfx)++, 0, 1, 2, 0, 0, 2, 3, 0);
+    *vtx = v + 4;
+}
+
+static void __bsshrine_rect(Gfx **gfx, Vtx **vtx, f32 x0, f32 y0, f32 x1, f32 y1, u8 r, u8 g, u8 b, u8 a){
+    f32 p[4][2];
+    p[0][0] = x0; p[0][1] = y0;
+    p[1][0] = x0; p[1][1] = y1;
+    p[2][0] = x1; p[2][1] = y1;
+    p[3][0] = x1; p[3][1] = y0;
+    __bsshrine_quad(gfx, vtx, p, r, g, b, a);
+}
+
+#ifdef SHRINE_TEST
+/* test builds only: surround Banjo with enemies shortly after boot (Grublins need Mumbo's Mountain) */
+#ifndef SHRINE_TEST_ACTOR
+#define SHRINE_TEST_ACTOR ACTOR_6_GRUBLIN
+#endif
+static s32 sShrineTestFrames;
+static void __bsshrine_testSpawn(void){
+    f32 pos[3];
+    f32 p[3];
+    s32 i;
+
+    if(++sShrineTestFrames != 120)
+        return;
+    playerPosition_get(pos);
+    for(i = 0; i < 6; i++){
+        p[0] = pos[0] + cosf(i * 1.047f) * 400.0f;
+        p[1] = pos[1];
+        p[2] = pos[2] + sinf(i * 1.047f) * 400.0f;
+        __spawnQueue_add_4((GenFunction_4)spawnQueue_actor_f32, SHRINE_TEST_ACTOR, reinterpret_cast(s32, p[0]), reinterpret_cast(s32, p[1]), reinterpret_cast(s32, p[2]));
+    }
+}
+#endif
+
+void bsshrine_draw(Gfx **gfx, Mtx **mtx, Vtx **vtx){
+    f32 k;
+    f32 w, h;
+    f32 p[4][2];
+    f32 nx, ny, len, t;
+    u8 a;
+    s32 i;
+
+#ifdef SHRINE_TEST
+    {
+        static char buf[24];
+        __bsshrine_testSpawn();
+        bk_strcpy(buf, "ALIVE ");
+        bk_strIToA(buf + 6, actorArray_actorCount(SHRINE_TEST_ACTOR));
+        print_dialog(20, 40, buf);
+        if(sShrineActive){
+            static char cbuf[40];
+            f32 pp[3], cp[3], rot[3];
+            playerPosition_get(pp);
+            viewport_getPosition_vec3f(cp);
+            viewport_getRotation_vec3f(rot);
+            bk_strcpy(cbuf, "D ");
+            bk_strIToA(cbuf + bk_strlen(cbuf), (s32)sqrtf((cp[0]-pp[0])*(cp[0]-pp[0]) + (cp[2]-pp[2])*(cp[2]-pp[2])));
+            bk_strcat(cbuf, " H ");
+            bk_strIToA(cbuf + bk_strlen(cbuf), (s32)(cp[1]-pp[1]));
+            bk_strcat(cbuf, " P ");
+            bk_strIToA(cbuf + bk_strlen(cbuf), (s32)rot[0]);
+            print_dialog(20, 200, cbuf);
+        }
+    }
+#endif
+    k = __bsshrine_intensity();
+    if(k <= 0.0f)
+        return;
+
+    w = (f32)gFramebufferWidth;
+    h = (f32)gFramebufferHeight;
+
+    viewport_setRenderViewportAndOrthoMatrix(gfx, mtx);
+    gDPPipeSync((*gfx)++);
+    gSPClearGeometryMode((*gfx)++, G_ZBUFFER | G_CULL_BOTH | G_FOG | G_LIGHTING | G_TEXTURE_GEN | G_TEXTURE_GEN_LINEAR | G_LOD);
+    gSPSetGeometryMode((*gfx)++, G_SHADE | G_SHADING_SMOOTH);
+    gSPTexture((*gfx)++, 0, 0, 0, G_TX_RENDERTILE, G_OFF);
+    gDPSetCycleType((*gfx)++, G_CYC_1CYCLE);
+    gDPSetCombineMode((*gfx)++, G_CC_SHADE, G_CC_SHADE);
+    gDPSetRenderMode((*gfx)++, G_RM_XLU_SURF, G_RM_XLU_SURF2);
+
+    /* blood-red wash over the whole domain */
+    __bsshrine_rect(gfx, vtx, 0.0f, 0.0f, w, h, 0x70, 0x00, 0x08, (u8)(k * 110.0f));
+
+    /* black cinematic bars; the titles are printed inside them */
+    t = SHRINE_BAR_HEIGHT * __bsshrine_clamp01(sShrineTimer / 0.5f)
+        * (1.0f - __bsshrine_clamp01((sShrineTimer - SHRINE_SLASH_END) / (SHRINE_FADE_END - SHRINE_SLASH_END)));
+    __bsshrine_rect(gfx, vtx, 0.0f, 0.0f, w, t, 0x00, 0x00, 0x00, 0xE0);
+    __bsshrine_rect(gfx, vtx, 0.0f, h - t, w, h, 0x00, 0x00, 0x00, 0xE0);
+
+    /* Dismantle / Cleave slash streaks */
+    for(i = 0; i < SHRINE_MAX_SLASHES; i++){
+        ShrineSlash *s = &sShrineSlashes[i];
+        if(s->life <= 0.0f)
+            continue;
+        nx = -(s->y1 - s->y0);
+        ny = s->x1 - s->x0;
+        len = sqrtf(nx * nx + ny * ny);
+        if(len < 1.0f)
+            continue;
+        nx = nx / len * s->width;
+        ny = ny / len * s->width;
+        /* red glow */
+        p[0][0] = s->x0 - nx * 2.5f; p[0][1] = s->y0 - ny * 2.5f;
+        p[1][0] = s->x0 + nx * 2.5f; p[1][1] = s->y0 + ny * 2.5f;
+        p[2][0] = s->x1 + nx * 2.5f; p[2][1] = s->y1 + ny * 2.5f;
+        p[3][0] = s->x1 - nx * 2.5f; p[3][1] = s->y1 - ny * 2.5f;
+        __bsshrine_quad(gfx, vtx, p, 0xFF, 0x10, 0x20, 0x90);
+        /* white-hot core */
+        p[0][0] = s->x0 - nx; p[0][1] = s->y0 - ny;
+        p[1][0] = s->x0 + nx; p[1][1] = s->y0 + ny;
+        p[2][0] = s->x1 + nx; p[2][1] = s->y1 + ny;
+        p[3][0] = s->x1 - nx; p[3][1] = s->y1 - ny;
+        __bsshrine_quad(gfx, vtx, p, 0xFF, 0xF0, 0xF0, 0xF0);
+    }
+
+    gDPPipeSync((*gfx)++);
+    gSPSetGeometryMode((*gfx)++, G_ZBUFFER);
+    viewport_setRenderViewportAndPerspectiveMatrix(gfx, mtx);
+}
